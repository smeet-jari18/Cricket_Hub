<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window: white, with the brand mark centred. Flutter paints
     its own splash on top of this as soon as the first frame is ready, so the
     two share the same artwork and there is no visible "swap". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
