<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always paints a splash screen, so tell it what to paint:
         our mark on white instead of the launcher icon on the theme colour. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
    </style>
</resources>
