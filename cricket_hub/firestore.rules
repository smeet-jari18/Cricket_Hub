rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isMatchScorer(matchId) {
      return signedIn() &&
        get(/databases/$(database)/documents/matches/$(matchId)).data.scorer_uid == request.auth.uid;
    }

    // CricketHub has no global "admin" role anywhere in the app schema - every
    // admin is per-document (grounds.owner_uid, tournaments.admin_uid, ...).
    // The Phase-3 addendum calls isAdmin() in 13 places, so it MUST be defined
    // or `firebase deploy --only firestore:rules` fails to compile.
    // This stays deny-by-default until you actually create /admins/{uid}
    // documents from the Firebase console or a Cloud Function.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isVerifiedGround(groundId) {
      return exists(/databases/$(database)/documents/grounds/$(groundId)) &&
        get(/databases/$(database)/documents/grounds/$(groundId)).data.verified == true &&
        get(/databases/$(database)/documents/grounds/$(groundId)).data.status == 'active';
    }

    function isVerifiedUmpire(umpireId) {
      return exists(/databases/$(database)/documents/umpires/$(umpireId)) &&
        get(/databases/$(database)/documents/umpires/$(umpireId)).data.verified == true &&
        get(/databases/$(database)/documents/umpires/$(umpireId)).data.status == 'active';
    }

    // Keep account PII private. Only the owner can read or edit this document;
    // Cloud Functions use the Admin SDK for trusted career-stat updates.
    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId) &&
        request.resource.data.keys().hasOnly([
          'phone_number', 'display_name', 'player_name_key', 'avatar_url',
          'role', 'batting_style', 'bowling_style', 'created_at'
        ]);
      allow update: if owns(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name', 'player_name_key', 'avatar_url', 'role',
          'batting_style', 'bowling_style', 'updated_at'
        ]);
      allow delete: if false;

      match /following_matches/{matchId} {
        allow read, write: if owns(userId);
      }

      // Phase 3: saved grounds + my bookings (mirror).
      match /favorite_grounds/{groundId} {
        allow read, write: if owns(userId);
      }
      match /bookings/{bookingId} {
        allow read: if owns(userId);
        allow write: if false; // Cloud Functions only.
      }
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.admin_uid == request.auth.uid;
      allow update: if signedIn() && resource.data.admin_uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'team_name', 'city', 'logo_url', 'roster', 'updated_at'
        ]);
      allow delete: if signedIn() && resource.data.admin_uid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.scorer_uid == request.auth.uid &&
        request.resource.data.status == 'scheduled' &&
        request.resource.data.team_a_id is string &&
        request.resource.data.team_a_id.size() > 0 &&
        request.resource.data.team_b_id is string &&
        request.resource.data.team_b_id.size() > 0 &&
        request.resource.data.team_a_id != request.resource.data.team_b_id &&
        request.resource.data.tournament_id == null &&
        request.resource.data.fixture_id == null &&
        request.resource.data.innings.size() == 0 &&
        request.resource.data.keys().hasOnly([
          'status', 'team_a_id', 'team_b_id', 'team_a_name', 'team_b_name',
          'total_overs', 'scorer_uid', 'scorer_name', 'tournament_admin_uid',
          'tournament_id', 'fixture_id', 'stage', 'round_number',
          'fixture_number', 'scheduled_at', 'innings', 'current_innings_number',
          'current_runs', 'current_wickets', 'legal_balls', 'created_at'
        ]);
      allow update: if isMatchScorer(matchId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'toss_winner', 'elected_to', 'batting_team_id', 'bowling_team_id',
          'current_batting_team_id', 'current_innings_number', 'status',
          'current_runs', 'current_wickets', 'legal_balls', 'striker_name',
          'non_striker_name', 'current_bowler_name', 'innings',
          'winner_team_id', 'result_type', 'result_text', 'completed_at',
          'updated_at'
        ]);
      allow delete: if false;

      match /balls/{ballId} {
        allow read: if signedIn();
        allow create, update, delete: if isMatchScorer(matchId);
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.admin_uid == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.format in ['round_robin', 'knockout'] &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.location is string &&
        request.resource.data.total_overs is int &&
        request.resource.data.total_overs in [5, 10, 15, 20, 25, 30] &&
        request.resource.data.team_ids.size() == 0 &&
        request.resource.data.points_table.size() == 0 &&
        request.resource.data.fixture_generation_status == 'not_generated' &&
        request.resource.data.keys().hasOnly([
          'name', 'location', 'format', 'status', 'admin_uid', 'start_at',
          'end_at', 'total_overs', 'team_ids', 'teams', 'points_config',
          'points_table', 'leaderboards', 'fixture_generation_status',
          'fixture_count', 'round_count', 'created_at', 'updated_at'
        ]);
      allow update: if signedIn() && resource.data.admin_uid == request.auth.uid &&
        resource.data.fixture_generation_status in ['not_generated', 'failed'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'location', 'start_at', 'end_at', 'format', 'total_overs',
          'team_ids', 'teams', 'points_config', 'updated_at'
        ]) &&
        request.resource.data.team_ids.size() <= 64;
      allow delete: if false;

      match /fixtures/{fixtureId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // Phase 2 aggregates are server-owned and cannot be changed by a client.
    match /player_stats/{playerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // =====================================================================
    // PHASE 3: GROUNDS, BOOKINGS, REVIEWS, UMPIRES, PAYOUTS
    // =====================================================================

    // ----- GROUNDS -----
    match /grounds/{groundId} {
      // `signedIn()` is required: the app never browses grounds anonymously
      // (Splash -> Login -> MainShell), and the Security doc puts "read all
      // grounds" under the Organizer/Player role. Without it, an unauthenticated
      // caller could read every active+verified ground document.
      allow read: if resource == null
        ? (signedIn() && request.auth.uid == request.resource.data.owner_uid)
        : signedIn() && (
              (resource.data.status == 'active' &&
               resource.data.verified == true) ||
              resource.data.owner_uid == request.auth.uid ||
              isAdmin()
            );

      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.verified == false &&
        request.resource.data.keys().hasOnly([
          'name', 'owner_uid', 'city', 'address', 'lat', 'lng',
          'pitch_type', 'amenities', 'photos', 'cover_photo_url',
          'price_weekday_hourly', 'price_weekend_hourly', 'price_full_day',
          'open_time', 'close_time', 'slot_duration_minutes',
          'status', 'verified', 'avg_rating', 'review_count', 'booking_count',
          'ground_stats', 'created_at', 'updated_at'
        ]) &&
        request.resource.data.pitch_type in ['turf', 'matting', 'concrete'] &&
        request.resource.data.price_weekday_hourly is int &&
        request.resource.data.price_weekday_hourly > 0 &&
        request.resource.data.price_weekend_hourly > 0;

      allow update: if signedIn() && resource.data.owner_uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'city', 'address', 'lat', 'lng',
          'pitch_type', 'amenities', 'photos', 'cover_photo_url',
          'price_weekday_hourly', 'price_weekend_hourly', 'price_full_day',
          'open_time', 'close_time', 'slot_duration_minutes',
          'status', 'updated_at'
        ]) &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.avg_rating == resource.data.avg_rating &&
        request.resource.data.review_count == resource.data.review_count &&
        request.resource.data.booking_count == resource.data.booking_count;

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verified', 'status', 'updated_at'
        ]);

      allow delete: if isAdmin();

      match /slots/{dateIso} {
        allow read: if signedIn() &&
          (isVerifiedGround(groundId) ||
           get(/databases/$(database)/documents/grounds/$(groundId)).data.owner_uid == request.auth.uid);

        allow write: if signedIn() &&
          get(/databases/$(database)/documents/grounds/$(groundId)).data.owner_uid == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'date', 'slots', 'blocked', 'block_reason', 'generated_at', 'updated_at'
          ]);
      }

      match /blocked_rules/{ruleId} {
        allow read, write: if signedIn() &&
          get(/databases/$(database)/documents/grounds/$(groundId)).data.owner_uid == request.auth.uid;
      }
    }

    // ----- BOOKINGS -----
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.organizer_uid == request.auth.uid ||
        resource.data.counterparty_uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.organizer_uid == request.auth.uid &&
        request.resource.data.status in ['held', 'pending_payment'] &&
        request.resource.data.kind in ['ground', 'umpire'] &&
        request.resource.data.amount_paise is int &&
        request.resource.data.amount_paise > 0 &&
        request.resource.data.payment_method in ['razorpay', 'cod'] &&
        request.resource.data.keys().hasOnly([
          'kind', 'resource_id', 'resource_name', 'organizer_uid', 'organizer_name',
          'counterparty_uid', 'counterparty_name', 'date', 'slot_start', 'slot_end',
          'duration_minutes', 'amount_paise', 'platform_fee_paise', 'payout_amount_paise',
          'payment_method', 'payment_status', 'status',
          'razorpay_order_id', 'razorpay_payment_id',
          'match_id', 'notes', 'created_at', 'updated_at',
          'qr_token', 'cancellation_reason', 'refund_amount_paise'
        ]);

      allow update: if signedIn() &&
        resource.data.organizer_uid == request.auth.uid &&
        resource.data.status == 'held' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'updated_at']);

      allow update: if signedIn() && resource.data.kind == 'umpire' &&
        resource.data.counterparty_uid == request.auth.uid &&
        resource.data.status == 'pending_payment' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']) &&
        request.resource.data.status in ['confirmed', 'cancelled'];

      allow update: if signedIn() && resource.data.kind == 'ground' &&
        resource.data.counterparty_uid == request.auth.uid &&
        resource.data.status == 'confirmed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cod_confirmed_at', 'updated_at'
        ]) &&
        request.resource.data.status in ['completed', 'no_show'];

      allow delete: if false;

      match /audit/{logId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.organizer_uid == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.counterparty_uid == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // ----- REVIEWS -----
    match /ground_reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.reviewer_uid == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /umpire_reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.reviewer_uid == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    // ----- UMPIRES -----
    match /umpires/{uid} {
      // Same `signedIn()` requirement as grounds. This one matters more:
      // umpires/{uid} stores `phone_number`, and the Security doc states it is
      // "blocked from public reads via rules". Without the auth check it was
      // world-readable.
      allow read: if resource == null
        ? (signedIn() && request.auth.uid == uid)
        : signedIn() && (
              (resource.data.status == 'active' &&
               resource.data.verified == true) ||
              resource.data.user_uid == request.auth.uid ||
              isAdmin()
            );

      allow create: if signedIn() &&
        request.resource.data.user_uid == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.verified == false &&
        request.resource.data.day_rate is int &&
        request.resource.data.day_rate > 0;

      allow update: if signedIn() && resource.data.user_uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'display_name', 'phone_number', 'city', 'experience_years',
          'certifications', 'day_rate', 'hourly_rate', 'bio', 'photo_url',
          'status', 'updated_at'
        ]) &&
        request.resource.data.verified == resource.data.verified &&
        request.resource.data.avg_rating == resource.data.avg_rating &&
        request.resource.data.review_count == resource.data.review_count &&
        request.resource.data.matches_officiated == resource.data.matches_officiated;

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'verified', 'status', 'updated_at'
        ]);

      allow delete: if isAdmin();

      match /availability/{dateIso} {
        allow read: if signedIn();
        allow write: if signedIn() &&
          get(/databases/$(database)/documents/umpires/$(uid)).data.user_uid == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'date', 'slots', 'updated_at'
          ]);
      }
    }

    // ----- PAYOUTS -----
    // NOTE: the addendum wrote `payout_ledger/{ownerUid}/{weekStartIso}`, but
    // functions/index.js:836 writes payout_ledger/{ownerUid}/weeks/{week},
    // and AppConstants.payoutWeeksSubCol == 'weeks'. Rules must match the path
    // the writer actually uses, otherwise the owner can never read payouts.
    match /payout_ledger/{ownerUid}/weeks/{weekStartIso} {
      allow read: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
      allow write: if false;
    }

    // ----- RAZORPAY EVENTS -----
    match /razorpay_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
